# ── Copia este archivo como .env y rellena los valores ──

# Base de datos (SQLite para desarrollo local)
DATABASE_URL="file:./dev.db"

# Secreto JWT (cámbialo en producción)
JWT_SECRET="allin-yachay-secret-key-2024-cambiar-en-produccion"

# Puerto del servidor (opcional, por defecto 3001)
PORT=3001

# API Key de Anthropic (necesaria para el chat Yachay)
# Obtén la tuya en: https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-..."

# Orígenes permitidos en producción (separados por comas)
# CORS_ORIGIN="https://educandes.vercel.app"
